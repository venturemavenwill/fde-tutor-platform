{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fde-tutor.local/schemas/evidence-evaluation.schema.json",
  "title": "FDE Tutor evidence evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evaluationId",
    "tenantId",
    "learnerId",
    "sourceEventIds",
    "contentNodeId",
    "contentRevision",
    "assessmentPosture",
    "masteryEffect",
    "observedCompetencyIds",
    "ordinalLevel",
    "narrative",
    "supportUsed",
    "grounding",
    "provenance",
    "reviewState"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "evaluationId": {
      "type": "string",
      "format": "uuid"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "learnerId": {
      "type": "string",
      "format": "uuid"
    },
    "sourceEventIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "contentNodeId": {
      "const": "S083"
    },
    "contentRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assessmentPosture": {
      "const": "NON_ASSESSMENT"
    },
    "masteryEffect": {
      "const": "NONE"
    },
    "observedCompetencyIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ordinalLevel": {
      "enum": [
        "EXPOSED",
        "RECOGNIZED",
        "RECALLED_WITH_SUPPORT",
        "RECALLED_UNAIDED",
        "APPLIED_IN_SIMULATION",
        "TRANSFERRED_TO_AUTHENTIC_WORK",
        "REVIEWED_AND_CONFIRMED"
      ]
    },
    "narrative": {
      "type": "string",
      "minLength": 20
    },
    "supportUsed": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "NONE",
          "SOURCE",
          "MINIMAL_CUE",
          "CONTRASTIVE_CASE",
          "CRITERION",
          "MODEL_ANSWER",
          "HUMAN_FEEDBACK"
        ]
      }
    },
    "grounding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "passageIds"
      ],
      "properties": {
        "result": {
          "enum": [
            "GROUNDED",
            "GROUNDING_REQUIRED",
            "NOT_APPLICABLE"
          ]
        },
        "passageIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rubricVersion",
        "policyVersion",
        "evaluatorVersion",
        "retrievalPolicyVersion"
      ],
      "properties": {
        "rubricVersion": {
          "type": "string"
        },
        "policyVersion": {
          "type": "string"
        },
        "evaluatorVersion": {
          "type": "string"
        },
        "modelVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrievalPolicyVersion": {
          "type": "string"
        }
      }
    },
    "reviewState": {
      "enum": [
        "NOT_REQUIRED",
        "REVIEW_REQUIRED",
        "CONFIRMED",
        "OVERRIDDEN",
        "DISPUTED"
      ]
    }
  }
}
